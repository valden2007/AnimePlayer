{
  "name": "anime-player",
  "version": "1.4.0",
  "description": "Десктопный аниме-плеер с онлайн-поиском на русском языке",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.animeplayer.app",
    "productName": "AnimePlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "providers/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "sign": false
    },
    "publish": {
      "provider": "github",
      "owner": "valden2007",
      "repo": "AnimePlayer"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "playwright": "^1.64.1"
  },
  "author": "AnimePlayer"
}
